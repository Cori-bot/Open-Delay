{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open-Delay",
  "version": "0.2.2",
  "identifier": "dev.opendelay.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build && python ../scripts/notices.py",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open-Delay",
        "width": 1100,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; frame-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local streaming delay, under your control",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../ui/dist/": "web/",
      "../dist/compliance/": "compliance/",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MTA3M0UxQzJENkRFMTEKUldRUjN0YkM0WE1ReDR3dGhUVHJyMG1CM3puMVZZY0Q5MVg2LzYyWXByZ0dYZTlRTEFPSjZVTUYK",
      "endpoints": [
        "https://github.com/Cori-bot/Open-Delay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
